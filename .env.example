# Production Environment Variables Template
# Copy these key-value pairs into Vercel / Serverless Environment Variables

DATABASE_URL="postgresql://postgres:[YOUR_DB_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[YOUR_DB_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR_SUPABASE_ANON_KEY]"

ADMIN_USERNAME="[YOUR_ADMIN_USERNAME]"
ADMIN_PASSWORD="[YOUR_ADMIN_PASSWORD]"

SESSION_SECRET="[GENERATE_A_RANDOM_64_CHARACTER_SECRET]"

TELEGRAM_BOT_TOKEN="[YOUR_TELEGRAM_BOT_TOKEN]"
TELEGRAM_CHAT_ID="[YOUR_TELEGRAM_CHAT_ID]"

NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/[YOUR_USERNAME]"
NEXT_PUBLIC_TELEGRAM_URL="https://t.me/[YOUR_USERNAME]"
NEXT_PUBLIC_SNAPCHAT_URL="https://www.snapchat.com/add/[YOUR_USERNAME]"
NEXT_PUBLIC_GITHUB_URL="https://github.com/[YOUR_USERNAME]"
NEXT_PUBLIC_LINKEDIN_URL="https://linkedin.com/in/[YOUR_USERNAME]"
NEXT_PUBLIC_EMAIL="mailto:[YOUR_EMAIL]"
